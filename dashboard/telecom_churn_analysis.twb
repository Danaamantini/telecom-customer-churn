    <worksheet name='Priority Churn Drivers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#dde4f0'>Competition and Service Experience Drive Priority-Segment Churn</run>
            <run>Æ&#10;</run>
            <run fontcolor='#a1abbd' fontsize='10'>83.5% of churn is linked to competitor pressure or service experience</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='clean_customers' name='federated.0r4tujw05frjw41cg8qi6137bgog' />
          </datasources>
          <datasource-dependencies datasource='federated.0r4tujw05frjw41cg8qi6137bgog'>
            <column caption='Churn Driver Group' datatype='string' name='[Calculation_3320847069196319]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [churn_category] = &quot;Competitor&quot;&#10;THEN &quot;Competitor&quot;&#10;&#10;ELSEIF [churn_category] = &quot;Dissatisfaction&quot;&#10;    OR [churn_category] = &quot;Attitude&quot;&#10;THEN &quot;Service Experience&quot;&#10;&#10;ELSEIF [churn_category] = &quot;Price&quot;&#10;THEN &quot;Price&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Driver Label' datatype='string' name='[Calculation_3320847072948258]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(COUNTD([customer_id]))&#10;+ &quot; | &quot;&#10;+ STR(&#10;    ROUND(&#10;        COUNTD([customer_id])&#10;        / TOTAL(COUNTD([customer_id]))&#10;        * 100,&#10;        1&#10;    )&#10;)&#10;+ &quot;%&quot;'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Churn Category' datatype='string' name='[churn_category]' role='dimension' type='nominal' />
            <column caption='Contract' datatype='string' name='[contract]' role='dimension' type='nominal' />
            <column-instance column='[customer_id]' derivation='CountD' name='[ctd:customer_id:qk]' pivot='key' type='quantitative' />
            <column caption='Customer Id' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column caption='Customer Status' datatype='string' name='[customer_status]' role='dimension' type='nominal' />
            <column caption='Internet Type' datatype='string' name='[internet_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3320847069196319]' derivation='None' name='[none:Calculation_3320847069196319:nk]' pivot='key' type='nominal' />
            <column-instance column='[contract]' derivation='None' name='[none:contract:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_status]' derivation='None' name='[none:customer_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[internet_type]' derivation='None' name='[none:internet_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[tenure_months]' derivation='None' name='[none:tenure_months:qk]' pivot='key' type='quantitative' />
            <column caption='Tenure Months' datatype='integer' name='[tenure_months]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3320847072948258]' derivation='User' name='[usr:Calculation_3320847072948258:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <manual-sort column='[federated.0r4tujw05frjw41cg8qi6137bgog].[none:Calculation_3320847069196319:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Competitor&quot;</bucket>
              <bucket>&quot;Service Experience&quot;</bucket>
              <bucket>&quot;Price&quot;</bucket>
              <bucket>&quot;Other&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.0r4tujw05frjw41cg8qi6137bgog].[none:contract:nk]'>
            <groupfilter function='member' level='[none:contract:nk]' member='&quot;Month-to-Month&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0r4tujw05frjw41cg8qi6137bgog].[none:customer_status:nk]'>
            <groupfilter function='member' level='[none:customer_status:nk]' member='&quot;Churned&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0r4tujw05frjw41cg8qi6137bgog].[none:internet_type:nk]'>
            <groupfilter function='member' level='[none:internet_type:nk]' member='&quot;Fiber Optic&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.0r4tujw05frjw41cg8qi6137bgog].[none:tenure_months:qk]' included-values='in-range'>
            <min>4</min>
            <max>24</max>
          </filter>
          <slices>
            <column>[federated.0r4tujw05frjw41cg8qi6137bgog].[none:internet_type:nk]</column>
            <column>[federated.0r4tujw05frjw41cg8qi6137bgog].[none:contract:nk]</column>
            <column>[federated.0r4tujw05frjw41cg8qi6137bgog].[none:tenure_months:qk]</column>
            <column>[federated.0r4tujw05frjw41cg8qi6137bgog].[none:customer_status:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0r4tujw05frjw41cg8qi6137bgog].[ctd:customer_id:qk]' scope='cols' value='' />
            <format attr='display' class='0' field='[federated.0r4tujw05frjw41cg8qi6137bgog].[ctd:customer_id:qk]' scope='cols' value='false' />
            <format attr='stroke-size' value='0' />
