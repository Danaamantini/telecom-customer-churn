      <column caption='Churn Rate' datatype='real' name='[Calculation_4758182708367360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([customer_status] = &apos;Churned&apos;, 1, 0)) / SUM(IIF([customer_status] = &apos;Joined&apos;, 0, 1))' />
      </column>
