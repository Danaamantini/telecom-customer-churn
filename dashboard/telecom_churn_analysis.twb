  <worksheets>
    <worksheet name='Contract Comparison'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f1f4fa'>Similar Customer Bases, Radically Different Churn</run>
            <run>Æ&#10;</run>
            <run fontcolor='#a1abbd' fontsize='10'>Month-to-Month versus One Year and Two Year combined</run>
            <run>Æ&#10;</run>
            <run fontcolor='#a1abbd' fontname='Tableau Book' fontsize='10'>51.7% M2M churn rate · 6.3% committed churn rate</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
