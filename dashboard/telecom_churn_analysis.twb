      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id]) / TOTAL(COUNTD([customer_id]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Existing Customers' datatype='integer' name='[Calculation_3320847024824322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] &lt;&gt; &quot;Joined&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_3320847025061891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='KPIChurn Rate' datatype='real' default-format='p0.0%' name='[Calculation_3320847025577989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;    THEN [customer_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Existing Monthly Revenue' datatype='real' name='[Calculation_3320847026847750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;    THEN [monthly_charge]&#10;    END&#10;)' />
      </column>
      <column caption='Churned Monthly Revenue' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_3320847026962439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;    THEN [monthly_charge]&#10;    END&#10;)' />
      </column>
      <column caption='KPI Churned Monthly Revenue %' datatype='real' default-format='p0.0%' name='[Calculation_3320847027101704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;    THEN [monthly_charge]&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;    THEN [monthly_charge]&#10;    END&#10;)' />
      </column>
      <column caption='KPI M2M Churned Customers' datatype='integer' name='[Calculation_3320847027413001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='KPI M2M Share of Churn' datatype='real' default-format='p0.0%' name='[Calculation_3320847027642380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;    THEN [customer_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Customer Value Segment' datatype='string' name='[Calculation_3320847055462413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [monthly_charge] &gt;= 90.40&#10;THEN &quot;High Value&quot;&#10;ELSE &quot;Standard Value&quot;&#10;END' />
      </column>
      <column caption='High-Value Churned Monthly Revenue' datatype='real' default-format='n&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_3320847055679503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [monthly_charge] &gt;= 90.40&#10;    THEN [monthly_charge]&#10;    END&#10;)' />
      </column>
      <column caption='KPI High-Value Revenue Exposure' datatype='real' default-format='p0.0%' name='[Calculation_3320847056158736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [monthly_charge] &gt;= 90.40&#10;    THEN [monthly_charge]&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;    THEN [monthly_charge]&#10;    END&#10;)' />
      </column>
      <column caption='Contract Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_3320847060361234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [contract] :&#10;    COUNTD(&#10;        IF [customer_status] = &quot;Churned&quot;&#10;        THEN [customer_id]&#10;        END&#10;    )&#10;}&#10;/&#10;{ FIXED [contract] :&#10;    COUNTD(&#10;        IF [customer_status] != &quot;Joined&quot;&#10;        THEN [customer_id]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Contract Churn Rate Label' datatype='real' default-format='p0.0%' name='[Calculation_3320847060533267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([customer_status]) = &quot;Churned&quot;&#10;THEN MIN([Calculation_3320847060361234])&#10;END' />
      </column>
      <column caption='M2M Existing Customers' datatype='integer' name='[Calculation_3320847063785495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='M2M Fiber Customers' datatype='integer' name='[Calculation_3320847064104986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;       AND [internet_type] = &quot;Fiber Optic&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Priority Segment Customers' datatype='integer' name='[Calculation_3320847064178715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;       AND [internet_type] = &quot;Fiber Optic&quot;&#10;       AND [tenure_months] &gt;= 4&#10;       AND [tenure_months] &lt;= 24&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Priority Segment Churned Customers' datatype='integer' name='[Calculation_3320847064244252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;       AND [internet_type] = &quot;Fiber Optic&quot;&#10;       AND [tenure_months] &gt;= 4&#10;       AND [tenure_months] &lt;= 24&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Priority Segment Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_3320847064322077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3320847064244252]&#10;/&#10;[Calculation_3320847064178715]' />
      </column>
      <column caption='Priority Segment Churned Revenue' datatype='real' default-format='n&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_3320847064449054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [contract] = &quot;Month-to-Month&quot;&#10;       AND [internet_type] = &quot;Fiber Optic&quot;&#10;       AND [tenure_months] &gt;= 4&#10;       AND [tenure_months] &lt;= 24&#10;    THEN [monthly_charge]&#10;    END&#10;)' />
      </column>
      <column caption='Churn Driver Group' datatype='string' name='[Calculation_3320847069196319]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churn_category] = &quot;Competitor&quot;&#10;THEN &quot;Competitor&quot;&#10;&#10;ELSEIF [churn_category] = &quot;Dissatisfaction&quot;&#10;    OR [churn_category] = &quot;Attitude&quot;&#10;THEN &quot;Service Experience&quot;&#10;&#10;ELSEIF [churn_category] = &quot;Price&quot;&#10;THEN &quot;Price&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Driver Label' datatype='string' name='[Calculation_3320847072948258]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD([customer_id]))&#10;+ &quot; | &quot;&#10;+ STR(&#10;    ROUND(&#10;        COUNTD([customer_id])&#10;        / TOTAL(COUNTD([customer_id]))&#10;        * 100,&#10;        1&#10;    )&#10;)&#10;+ &quot;%&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_3320847224119331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Committed Existing Customers' datatype='integer' name='[Calculation_3320847224164388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] != &quot;Joined&quot;&#10;       AND [contract] != &quot;Month-to-Month&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
      </column>
      <column caption='Committed Churned Customers' datatype='integer' name='[Calculation_3320847224242213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [customer_status] = &quot;Churned&quot;&#10;       AND [contract] != &quot;Month-to-Month&quot;&#10;    THEN [customer_id]&#10;    END&#10;)' />
