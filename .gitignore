# ---------------------------------------------------------------------------
# Telecom Customer Churn — .gitignore
# ---------------------------------------------------------------------------

# ---- Data (immutable raw + derived artifacts must NOT be tracked) ----------
# Ignore source/generated data files, but keep directory placeholders tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
*.ipynb_checkpoints/
.jupyter-config/
.jupyter-data/
.ipython-data/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ---- Logs & secrets --------------------------------------------------------
*.log
.env
.env.*
!.env.example

# ---- Local scaffolding / tooling (not published) ---------------------------
.opencode/
AGENTS.md
opencode.json
prompt-1
prompt-2

# ---- Personal project notes (local only) -----------------------------------
# Keep repository-reading guides, work plans, and interview preparation out
# of the public portfolio. Public technical documentation belongs in README.md
# or reports/.
REPO_TOUR.md
reports/portfolio_plan.md
notes/
docs/private/
interview-prep/
INTERVIEW*.md
interview_*.md
