<?xml version="1.0" encoding="utf-8" ?>
<!--
  ============================================================================
  Telecom Customer Churn — Tableau workbook STARTER (phase 6 hand-off)
  File: reports/tableau/telecom_churn_dashboard.twb

  This is a well-formed, version-agnostic workbook skeleton. To open in
  Tableau Desktop:
    1. Open the file; Tableau will prompt to locate the two CSV files.
       - Primary:   data/processed/clean_customers.csv  (name: clean_customers)
       - Secondary: data/raw/telecom_zipcode_population.csv (name: zipcode_population)
    2. Repoint the `directory`/`filename` attributes of each <connection
       class="textscan"> block below to your local absolute paths.
    3. The regional choropleth blends zipcode_population on
       [zip_code] = [Zip Code] (population normalization via MAX([Population])).

  Calculated fields mirror reports/tableau/calculated_fields.md EXACTLY
  (customer-level variants against clean_customers; see that file for the
  pre-aggregated v_churn_metrics / v_revenue_leakage equivalents).
  Dashboards follow reports/tableau/dashboard_wireframes.md.

  NOTE: This is a skeleton — worksheets carry simplified mark/encoding XML and
  are meant to be re-pointed and finalized in Tableau Desktop, not a
  pixel-perfect deliverable.
  ============================================================================
-->
<workbook source-build="2024.1.0" source-platform="win" version="2024.1" xmlns:user="http://www.tableausoftware.com/xml/user">

  <datasources>
    <!-- ====================================================================
         PRIMARY DATASOURCE: clean_customers (customer grain, one row/customer)
         ==================================================================== -->
    <datasource caption="clean_customers" inline="true" name="federated.0x1" version="2024.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="clean_customers" name="textscan.0x1">
            <connection class="textscan"
                        dbname="clean_customers.csv"
                        directory="data/processed"
                        filename="clean_customers.csv"
                        odbc-connect-string-extras=""
                        password=""
                        server=""
                        sslmode=""
                        username="">
              <relation name="clean_customers#csv" table="[clean_customers#csv]" type="table" />
              <text-dialect />
            </connection>
          </named-connection>
        </named-connections>
        <relation connection="textscan.0x1" name="clean_customers#csv" table="[clean_customers#csv]" type="table" />
      </connection>
      <aliases enabled="yes" />

      <!-- dimensions -->
      <column caption="customer_id" datatype="string" name="[customer_id]" role="dimension" type="nominal" />
      <column caption="gender" datatype="string" name="[gender]" role="dimension" type="nominal" />
      <column caption="married" datatype="boolean" name="[married]" role="dimension" type="nominal" />
      <column caption="city" datatype="string" name="[city]" role="dimension" type="nominal" />
      <column caption="zip_code" datatype="string" name="[zip_code]" role="dimension" type="nominal" />
      <column caption="offer" datatype="string" name="[offer]" role="dimension" type="nominal" />
      <column caption="phone_service" datatype="boolean" name="[phone_service]" role="dimension" type="nominal" />
      <column caption="multiple_lines" datatype="boolean" name="[multiple_lines]" role="dimension" type="nominal" />
      <column caption="internet_service" datatype="boolean" name="[internet_service]" role="dimension" type="nominal" />
      <column caption="internet_type" datatype="string" name="[internet_type]" role="dimension" type="nominal" />
      <column caption="online_security" datatype="boolean" name="[online_security]" role="dimension" type="nominal" />
      <column caption="online_backup" datatype="boolean" name="[online_backup]" role="dimension" type="nominal" />
      <column caption="device_protection_plan" datatype="boolean" name="[device_protection_plan]" role="dimension" type="nominal" />
      <column caption="premium_tech_support" datatype="boolean" name="[premium_tech_support]" role="dimension" type="nominal" />
      <column caption="streaming_tv" datatype="boolean" name="[streaming_tv]" role="dimension" type="nominal" />
      <column caption="streaming_movies" datatype="boolean" name="[streaming_movies]" role="dimension" type="nominal" />
      <column caption="streaming_music" datatype="boolean" name="[streaming_music]" role="dimension" type="nominal" />
      <column caption="unlimited_data" datatype="boolean" name="[unlimited_data]" role="dimension" type="nominal" />
      <column caption="contract" datatype="string" name="[contract]" role="dimension" type="nominal" />
      <column caption="paperless_billing" datatype="boolean" name="[paperless_billing]" role="dimension" type="nominal" />
      <column caption="payment_method" datatype="string" name="[payment_method]" role="dimension" type="nominal" />
      <column caption="customer_status" datatype="string" name="[customer_status]" role="dimension" type="nominal" />
      <column caption="churn_category" datatype="string" name="[churn_category]" role="dimension" type="nominal" />
      <column caption="churn_reason" datatype="string" name="[churn_reason]" role="dimension" type="nominal" />
      <column caption="churn" datatype="boolean" name="[churn]" role="dimension" type="nominal" />
      <column caption="tenure_bin" datatype="string" name="[tenure_bin]" role="dimension" type="nominal" />
      <column caption="is_fiber" datatype="boolean" name="[is_fiber]" role="dimension" type="nominal" />

      <!-- measures -->
      <column caption="age" datatype="integer" name="[age]" role="measure" type="quantitative" />
      <column caption="num_dependents" datatype="integer" name="[num_dependents]" role="measure" type="quantitative" />
      <column caption="latitude" datatype="real" name="[latitude]" role="measure" type="quantitative" />
      <column caption="longitude" datatype="real" name="[longitude]" role="measure" type="quantitative" />
      <column caption="num_referrals" datatype="integer" name="[num_referrals]" role="measure" type="quantitative" />
      <column caption="tenure_months" datatype="integer" name="[tenure_months]" role="measure" type="quantitative" />
      <column caption="avg_monthly_long_distance_charges" datatype="real" name="[avg_monthly_long_distance_charges]" role="measure" type="quantitative" />
      <column caption="avg_monthly_gb_download" datatype="integer" name="[avg_monthly_gb_download]" role="measure" type="quantitative" />
      <column caption="monthly_charge" datatype="real" name="[monthly_charge]" role="measure" type="quantitative" />
      <column caption="total_charges" datatype="real" name="[total_charges]" role="measure" type="quantitative" />
      <column caption="total_refunds" datatype="real" name="[total_refunds]" role="measure" type="quantitative" />
      <column caption="total_extra_data_charges" datatype="real" name="[total_extra_data_charges]" role="measure" type="quantitative" />
      <column caption="total_long_distance_charges" datatype="real" name="[total_long_distance_charges]" role="measure" type="quantitative" />
      <column caption="total_revenue" datatype="real" name="[total_revenue]" role="measure" type="quantitative" />
      <column caption="contract_commitment" datatype="integer" name="[contract_commitment]" role="measure" type="quantitative" />
      <column caption="bundle_count" datatype="integer" name="[bundle_count]" role="measure" type="quantitative" />

      <!-- parameters (external inputs) -->
      <column caption="Gross Margin" datatype="real" name="[Parameters].[Gross Margin]" role="measure" type="quantitative">
        <calculation class="tableau" formula="0.5" />
        <param-domain>
          <range max="1" min="0" type="range" />
        </param-domain>
      </column>

      <!-- calculated fields (see reports/tableau/calculated_fields.md) -->
      <column caption="Contract Churn Rate" datatype="real" name="[Contract Churn Rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [contract] : SUM(IIF([customer_status] = 'Joined', 0, IIF([churn], 1, 0))) / SUM(IIF([customer_status] = 'Joined', 0, 1)) }" />
      </column>
      <column caption="Churn Rate %" datatype="real" name="[Churn Rate %]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([customer_status] = 'Joined', 0, IIF([churn], 1, 0))) / SUM(IIF([customer_status] = 'Joined', 0, 1))" />
      </column>
      <column caption="MRR Impact" datatype="real" name="[MRR Impact]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IIF([churn], [monthly_charge], 0))" />
      </column>
      <column caption="Annualized Revenue at Risk" datatype="real" name="[Annualized Revenue at Risk]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[MRR Impact] * 12" />
      </column>
      <column caption="Revenue at Risk 24m" datatype="real" name="[Revenue at Risk 24m]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[MRR Impact] * 24" />
      </column>
      <column caption="Revenue at Risk 36m" datatype="real" name="[Revenue at Risk 36m]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[MRR Impact] * 36" />
      </column>
      <column caption="CLV" datatype="real" name="[CLV]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[monthly_charge] * [Gross Margin] * (1 / [Contract Churn Rate])" />
      </column>
      <column caption="Retention Rate" datatype="real" name="[Retention Rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1 - [Churn Rate %]" />
      </column>

      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.5" show-structure="true" />
    </datasource>

    <!-- ====================================================================
         SECONDARY DATASOURCE: zipcode_population (map/population reference)
         For the regional choropleth, blend/join on:
           [zip_code] (clean_customers) = [Zip Code] (zipcode_population)
         ==================================================================== -->
    <datasource caption="zipcode_population" inline="true" name="federated.0x2" version="2024.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="zipcode_population" name="textscan.0x2">
            <connection class="textscan"
                        dbname="telecom_zipcode_population.csv"
                        directory="data/raw"
                        filename="telecom_zipcode_population.csv"
                        odbc-connect-string-extras=""
                        password=""
                        server=""
                        sslmode=""
                        username="">
              <relation name="telecom_zipcode_population#csv" table="[telecom_zipcode_population#csv]" type="table" />
              <text-dialect />
            </connection>
          </named-connection>
        </named-connections>
        <relation connection="textscan.0x2" name="telecom_zipcode_population#csv" table="[telecom_zipcode_population#csv]" type="table" />
      </connection>
      <aliases enabled="yes" />
      <column caption="Zip Code" datatype="string" name="[Zip Code]" role="dimension" type="nominal" />
      <column caption="Population" datatype="integer" name="[Population]" role="measure" type="quantitative" />
      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.5" show-structure="true" />
    </datasource>
  </datasources>

  <!-- ======================================================================
       WORKSHEETS (simplified marks/encodings — finalize in Tableau Desktop)
       ====================================================================== -->
  <worksheets>
    <worksheet name="Churn by Contract">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[contract]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Internet Type">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[internet_type]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Payment Method">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[payment_method]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Tenure Bin">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Line" /></pane></panes>
        <rows>[tenure_bin]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Offer">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[offer]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Fiber vs Non-Fiber">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[is_fiber]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Revenue at Risk by Horizon">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[Measure Names]</rows>
        <cols>[Measure Values]</cols>
      </table>
    </worksheet>
    <worksheet name="Revenue at Risk 36m by Contract">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[contract]</rows>
        <cols>SUM([Revenue at Risk 36m])</cols>
      </table>
    </worksheet>
    <worksheet name="MRR Impact by Contract x Tenure">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[tenure_bin]</rows>
        <cols>SUM([MRR Impact])</cols>
      </table>
    </worksheet>
    <worksheet name="Revenue at Risk 12m by Internet Type">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[internet_type]</rows>
        <cols>SUM([Annualized Revenue at Risk])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Add-on Combo">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Square" /></pane></panes>
        <rows>[online_security]</rows>
        <cols>[device_protection_plan]</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Bundle Count">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[bundle_count]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Feature Importance">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[Measure Names]</rows>
        <cols>[Measure Values]</cols>
      </table>
    </worksheet>
    <worksheet name="Early-Tenure Churn">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Line" /></pane></panes>
        <rows>[tenure_bin]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Zip Map">
      <table>
        <view><datasources>
          <datasource caption="clean_customers" name="federated.0x1" />
          <datasource caption="zipcode_population" name="federated.0x2" />
        </datasources></view>
        <panes><pane id="0"><mark class="Automatic" /></pane></panes>
        <rows>[latitude]</rows>
        <cols>[longitude]</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Top Cities">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[city]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Churn by Technology">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Bar" /></pane></panes>
        <rows>[internet_type]</rows>
        <cols>SUM([Churn Rate %])</cols>
      </table>
    </worksheet>
    <worksheet name="Tech x Region Heatmap">
      <table>
        <view><datasources><datasource caption="clean_customers" name="federated.0x1" /></datasources></view>
        <panes><pane id="0"><mark class="Square" /></pane></panes>
        <rows>[internet_type]</rows>
        <cols>[city]</cols>
      </table>
    </worksheet>
  </worksheets>

  <!-- ======================================================================
       DASHBOARDS (four) — KPIs + charts per dashboard_wireframes.md
       ====================================================================== -->
  <dashboards>
    <dashboard caption="Churn Overview" name="Churn Overview">
      <size maxheight="2000" maxwidth="2000" minheight="600" minwidth="1000" />
      <dash-style-name>Clean</dash-style-name>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="50000" id="2" name="Churn by Contract" w="50000" x="0" y="0" />
          <zone h="50000" id="3" name="Churn by Internet Type" w="50000" x="50000" y="0" />
          <zone h="50000" id="4" name="Churn by Payment Method" w="50000" x="0" y="50000" />
          <zone h="50000" id="5" name="Churn by Tenure Bin" w="50000" x="50000" y="50000" />
          <zone h="50000" id="6" name="Churn by Offer" w="50000" x="0" y="100000" />
          <zone h="50000" id="7" name="Fiber vs Non-Fiber" w="50000" x="50000" y="100000" />
        </zone>
      </zones>
    </dashboard>

    <dashboard caption="Revenue at Risk" name="Revenue at Risk">
      <size maxheight="2000" maxwidth="2000" minheight="600" minwidth="1000" />
      <dash-style-name>Clean</dash-style-name>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="50000" id="2" name="Revenue at Risk by Horizon" w="50000" x="0" y="0" />
          <zone h="50000" id="3" name="Revenue at Risk 12m by Internet Type" w="50000" x="50000" y="0" />
          <zone h="50000" id="4" name="MRR Impact by Contract x Tenure" w="50000" x="0" y="50000" />
          <zone h="50000" id="5" name="Revenue at Risk 36m by Contract" w="50000" x="50000" y="50000" />
        </zone>
      </zones>
    </dashboard>

    <dashboard caption="Retention Drivers" name="Retention Drivers">
      <size maxheight="2000" maxwidth="2000" minheight="600" minwidth="1000" />
      <dash-style-name>Clean</dash-style-name>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="50000" id="2" name="Churn by Add-on Combo" w="50000" x="0" y="0" />
          <zone h="50000" id="3" name="Churn by Bundle Count" w="50000" x="50000" y="0" />
          <zone h="50000" id="4" name="Feature Importance" w="50000" x="0" y="50000" />
          <zone h="50000" id="5" name="Early-Tenure Churn" w="50000" x="50000" y="50000" />
        </zone>
      </zones>
    </dashboard>

    <dashboard caption="Regional &amp; Infrastructure" name="Regional &amp; Infrastructure">
      <size maxheight="2000" maxwidth="2000" minheight="600" minwidth="1000" />
      <dash-style-name>Clean</dash-style-name>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="50000" id="2" name="Churn by Zip Map" w="50000" x="0" y="0" />
          <zone h="50000" id="3" name="Churn by Technology" w="50000" x="50000" y="0" />
          <zone h="50000" id="4" name="Churn by Top Cities" w="50000" x="0" y="50000" />
          <zone h="50000" id="5" name="Tech x Region Heatmap" w="50000" x="50000" y="50000" />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
